{
  "name": "is-this-a-scam",
  "productName": "Is This A Scam?",
  "version": "1.0.0",
  "description": "Paste a link, get a scam score out of 100.",
  "author": "Peter",
  "license": "MIT",
  "homepage": "https://github.com/peter-research/is-this-a-scam",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.isthisascam.app",
    "productName": "Is This A Scam?",
    "directories": { "output": "../dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*", "build/icon.png"],
    "linux": {
      "target": ["AppImage", "deb"],
      "maintainer": "Peter <peter-research@users.noreply.github.com>",
      "category": "Utility",
      "synopsis": "Scam checker",
      "description": "Paste a link and get a trust score out of 100, built from public reputation sources.",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
